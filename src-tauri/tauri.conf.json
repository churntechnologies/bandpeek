{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BandPeek",
  "version": "0.1.0-beta.1",
  "identifier": "io.github.churntechnologies.bandpeek",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Utility",
    "copyright": "Copyright \u00a9 2026 BandPeek contributors. MIT License.",
    "shortDescription": "Per-app network activity in your menu bar",
    "longDescription": "BandPeek shows which applications use your network and how much, from the macOS menu bar. Local-only; no accounts, analytics or cloud.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/churntechnologies/bandpeek/releases/latest/download/latest.json"
      ]
    }
  }
}
